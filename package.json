{
  "name": "@soft-advisor/env-sources",
  "version": "0.1.2",
  "description": "Resolve an app's environment variables at deploy time from explicit sources, such as AWS Parameter Store, and validate them with any Standard Schema validator (Zod, Valibot, ArkType)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soft-advisor/env-sources.git"
  },
  "keywords": [
    "environment-variables",
    "env",
    "aws",
    "ssm",
    "parameter-store",
    "standard-schema",
    "zod",
    "sst"
  ],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssm": {
      "types": "./dist/ssm.d.ts",
      "default": "./dist/ssm.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "lint": "biome check",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@aws-sdk/client-ssm": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-ssm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "3.1165.0",
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
